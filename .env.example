# ========================================
# LOCAL DEVELOPMENT
# ========================================

# Database (Railway creates DATABASE_URL on production)
DATABASE_URL=postgresql://welfare:welfare123@localhost:5432/welfare_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Cloud APIs
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project
GOOGLE_CLOUD_CREDENTIALS_PATH=/path/to/credentials.json

# Application
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
SQL_ECHO=false
LOG_LEVEL=INFO

# Features
VOICE_ENABLED=true
OFFLINE_ENABLED=true
MULTILINGUAL_SUPPORT=true

# ========================================
# PRODUCTION (Cloudflare Pages + Railway)
# ========================================
# For Railway backend:
# - DATABASE_URL is auto-generated (no need to set)
# - CORS_ORIGINS = your Cloudflare Pages URL
# - ANTHROPIC_API_KEY = your actual key
#
# Example production values:
# ENVIRONMENT=production
# CORS_ORIGINS=https://your-project.pages.dev
# ANTHROPIC_API_KEY=sk-ant-your-actual-key
